# T2.6: canopen_slave_accelmotor — single-axis X stage-motor CANopen slave
# (XIAO ESP32-S3). Feature set: base + MOTOR + HOME + USE_ACCELSTEP + TMC +
# LINEAR_ENCODER + AXIS (matches the app's main/PinConfig.h).
#
# CAN is the transport (CANopen stack, node id 1, 500 kbit/s).

CONFIG_UC2_FEATURE_BASE=y
CONFIG_UC2_DIGITAL_IN_CONTROLLER=y
CONFIG_UC2_MESSAGE_CONTROLLER=y
CONFIG_UC2_CAN_BUS_ENABLED=y
CONFIG_UC2_CAN_CONTROLLER=y
CONFIG_UC2_CAN_CONTROLLER_CANOPEN=y
CONFIG_UC2_CAN_RECEIVE_MOTOR=y
CONFIG_UC2_MOTOR_CONTROLLER=y
CONFIG_UC2_HOME_MOTOR=y
CONFIG_UC2_USE_ACCELSTEP=y
CONFIG_UC2_TMC_CONTROLLER=y
CONFIG_UC2_LINEAR_ENCODER_CONTROLLER=y
CONFIG_UC2_AXIS_CONTROLLER=y

CONFIG_ESP32S3_DEFAULT_CPU_FREQ_240=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
# T2.6: shared partition table (repo root, same file every app uses).
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../../custom_partition_esp32s3.csv"
CONFIG_PARTITION_TABLE_MD5=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_DISABLE=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OPI=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=64
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=y
CONFIG_ESP_WIFI_NVS_ENABLED=n
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
CONFIG_BT_ENABLED=n
CONFIG_ESP_TLS_INSECURE=y
CONFIG_HTTPD_WS_STACK_SIZE=4096
CONFIG_VFS_SUPPORT_IO=y
CONFIG_VFS_SUPPORT_WIFI=y
CONFIG_VFS_SUPPORT_LOOP=y
CONFIG_LOG_DEFAULT_LEVEL_DEBUG=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTION_MESSAGES=y
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_SPI_FLASH_ROM_IMPL=y
CONFIG_SPI_FLASH_ROM_BOOTLOADER=y
CONFIG_PARTITION_TABLE_OFFSET=0x8000
CONFIG_ESP32S3_DATA_CACHE_64KB=y
