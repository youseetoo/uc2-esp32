# T2.4: canopen_slave_led feature set (from PIO env UC2_canopen_slave_led_release).
# Target: esp32s3 (XIAO ESP32S3). Console: USB-Serial-JTAG.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../../custom_partition_esp32s3.csv"

# UC2 feature flags (env-app-mapping.md: base + LED + LASER + THERMAL; DEBUG=0)
CONFIG_UC2_NODE_ROLE=2
CONFIG_UC2_CORE_DEBUG_LEVEL=0
CONFIG_UC2_MESSAGE_CONTROLLER=y
CONFIG_UC2_DIGITAL_IN_CONTROLLER=y
CONFIG_UC2_CAN_BUS_ENABLED=y
CONFIG_UC2_CAN_CONTROLLER_CANOPEN=y
CONFIG_UC2_LASER_CONTROLLER=y
CONFIG_UC2_LED_CONTROLLER=y
CONFIG_UC2_THERMAL_CONTROLLER=y

# CANopen TWAI deprecation suppression (IDF 6.1)
CONFIG_TWAI_SUPPRESS_DEPRECATE_WARN=y

# Strict flags (T1.1)
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_LEVEL=y
CONFIG_COMPILER_STACK_CHECK=y
