  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D M:\repos\uc2-esp32\apps\canopen_slave_laser\build\bootloader\esp-idf\esp_security && C:\Users\troop\.espressif\tools\cmake\4.0.3\bin\cmake-gui.exe -SM:\.espressif\v6.1\esp-idf\components\bootloader\subproject -BM:\repos\uc2-esp32\apps\canopen_slave_laser\build\bootloader"
  DESC = Running CMake cache editor...
  pool = console
  restat = 1

