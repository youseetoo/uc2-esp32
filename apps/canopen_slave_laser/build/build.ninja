build esp-idf/tcp_transport/CMakeFiles/install/strip.util: CUSTOM_COMMAND esp-idf/tcp_transport/all
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D M:\repos\uc2-esp32\apps\canopen_slave_laser\build\esp-idf\tcp_transport && C:\Users\troop\.espressif\tools\cmake\4.0.3\bin\cmake.exe -DCMAKE_INSTALL_DO_STRIP=1 -P cmake_install.cmake"
  DESC = Installing the project stripped...
  pool = console
  restat = 1

build esp-idf/tcp_transport/install/strip: phony esp-idf/tcp_transport/CMakeFiles/install/strip.util

