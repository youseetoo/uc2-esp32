  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D M:\repos\uc2-esp32\apps\canopen_slave_laser\build\esp-idf\esp_netif_stack && C:\Users\troop\.espressif\tools\cmake\4.0.3\bin\cmake.exe -DCMAKE_INSTALL_LOCAL_ONLY=1 -P cmake_install.cmake"
  DESC = Installing only the local directory...
  pool = console
  restat = 1

