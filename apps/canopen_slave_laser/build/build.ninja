  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D M:\repos\uc2-esp32\apps\canopen_slave_laser\build && C:\Users\troop\.espressif\tools\cmake\4.0.3\bin\cmake.exe -E echo "Error: The target encrypted-app-flash requires" && C:\Users\troop\.espressif\tools\cmake\4.0.3\bin\cmake.exe -E echo "CONFIG_SECURE_FLASH_ENCRYPTION_MODE_DEVELOPMENT to be enabled." && C:\Users\troop\.espressif\tools\cmake\4.0.3\bin\cmake.exe -E env "FAIL_MESSAGE=Failed executing target (see errors on lines above)" C:/Users/troop/.espressif/tools/cmake/4.0.3/bin/cmake.exe -P M:/.espressif/v6.1/esp-idf/tools/cmake/scripts/fail.cmake"


