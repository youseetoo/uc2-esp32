# T5.4: waveshare_d7 feature set (from PIO env waveshare_esp32s3_7inchScreen).
# Target: esp32s3 (Waveshare 7" screen, esp32s3box). Console: USB-Serial-JTAG.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../../partitions/custom_partition_esp32s3.csv"

# CAN TWAI deprecation suppression (IDF 6.1): the CANopen path uses the legacy
# driver/twai.h API; suppress its #warning under -Werror until it moves to esp_twai.h.
CONFIG_TWAI_SUPPRESS_DEPRECATE_WARN=y

# UC2 feature flags (from PIO build_flags): CAN motor node (NODE_ROLE=2) with the
# FAS (FastAccelStepper) stepper + message controller. No home/TMC/linear-encoder
# controllers (the PIO env does not enable them).
CONFIG_UC2_NODE_ROLE=2
CONFIG_UC2_CORE_DEBUG_LEVEL=0
CONFIG_UC2_MESSAGE_CONTROLLER=y
CONFIG_UC2_MOTOR_CONTROLLER=y
CONFIG_UC2_USE_FASTACCEL=y
CONFIG_UC2_CAN_BUS_ENABLED=y
CONFIG_UC2_CAN_CONTROLLER_CANOPEN=y

# Strict flags (T1.1)
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_LEVEL=y
CONFIG_COMPILER_STACK_CHECK=y
