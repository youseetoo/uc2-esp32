# T2.9: xiao_odmr feature set (from PIO env seeed_xiao_esp32s3).
# Target: esp32s3 (XIAO ESP32S3). Console: USB-Serial-JTAG.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../../partitions/custom_partition_esp32s3.csv"

# UC2 feature flags (from platformio.ini seeed_xiao_esp32s3 build_flags).
# Note: UC2_I2C_SLAVE_MOTOR is a no-op — the code was removed in 7ef0bcb.
# Kept for parity with the env-app-mapping table.
CONFIG_UC2_NODE_ROLE=2
CONFIG_UC2_CORE_DEBUG_LEVEL=5
CONFIG_UC2_MOTOR_CONTROLLER=y
CONFIG_UC2_LASER_CONTROLLER=y
CONFIG_UC2_LED_CONTROLLER=y
CONFIG_UC2_DIGITAL_IN_CONTROLLER=y
CONFIG_UC2_I2C_SLAVE_MOTOR=y
CONFIG_UC2_MESSAGE_CONTROLLER=y
CONFIG_UC2_USE_ACCELSTEP=y
CONFIG_UC2_LINEAR_ENCODER_CONTROLLER=y
CONFIG_UC2_HEAT_CONTROLLER=y
CONFIG_UC2_HOME_MOTOR=y
CONFIG_UC2_STAGE_SCAN=y

# Strict flags (T1.1)
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_LEVEL=y
CONFIG_COMPILER_STACK_CHECK=y
