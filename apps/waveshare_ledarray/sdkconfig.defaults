# T2.2: waveshare_ledarray feature set (from PIO env waveshare_esp32s3_ledarray).
# Target: esp32s3 (Waveshare ESP32S3). Console: USB-Serial-JTAG.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../../partitions/custom_partition_esp32s3_waveshare.csv"

# UC2 feature flags (T2.2: LED + message only; no motors, no laser, no digital-in)
CONFIG_UC2_NODE_ROLE=2
CONFIG_UC2_CORE_DEBUG_LEVEL=5
CONFIG_UC2_MESSAGE_CONTROLLER=y
CONFIG_UC2_LED_CONTROLLER=y

# Strict flags (T1.1)
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_LEVEL=y
CONFIG_COMPILER_STACK_CHECK=y
