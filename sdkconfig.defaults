#
# UC2-ESP32 — root sdkconfig.defaults  (T1.1, D1 = ESP-IDF 6.1)
#
# This file is DELIBERATE, not a dump. Every active line is an intentional
# choice; anything not listed here stays at its ESP-IDF 6.1 default.
#
# It REPLACES the 1,610-line auto-generated sdkconfig.defaults that shipped on
# main_espidf. That dump is preserved in git history and alongside the 96 stale
# sdkconfig.* files at the repo root — those are deleted in T2.11, so do NOT
# delete them yet (T1.1).
#
# IDF layering (merged in this order, later files win):
#   1. this root file               — target-agnostic defaults (below)
#   2. sdkconfig.defaults.esp32     — auto-picked when IDF_TARGET=esp32
#      sdkconfig.defaults.esp32s3   — auto-picked when IDF_TARGET=esp32s3
#   3. apps/<app>/sdkconfig.defaults — per-app feature symbols (UC2_*), the BT
#      stack, and the S3 USB-Serial-JTAG console (T1.5+ / Phase 3)
#

# ── App version ──────────────────────────────────────────────────────────────
# Embed a 16-byte ELF SHA in the app version string so every build is uniquely
# identifiable at runtime. The git tag itself is injected as the project version
# by the app build.sh wrapper (T1.5) / top-level CMake (T1.2), so a flashed unit
# reports the exact tag it was cut from.
CONFIG_APP_RETRIEVE_LEN_ELF_SHA=16

# ── Build system ─────────────────────────────────────────────────────────────
# ccache is OFF for the IDF-native build. In IDF 6.1 ccache is a CMake variable
# (CCACHE_ENABLE, see tools/cmake/project.cmake:706), not a Kconfig option, and
# it defaults to off — so no line is needed; we simply never pass
# -DCCACHE_ENABLE=1. (The PIO build uses ccache via CMAKE_*_COMPILER_LAUNCHER;
# that path is untouched.)
#
# Compiler optimization: DEFAULT (the IDF default -Og for app code). The old PIO
# dump forced SIZE (-Os); we take the deliberate DEFAULT so the perf-critical
# axis / motor / encoder loops are not over-shrunk. The bootloader keeps its own
# -Os regardless.
CONFIG_COMPILER_OPTIMIZATION_DEFAULT=y

# ── Kernel / scheduling ──────────────────────────────────────────────────────
# Main task stack: 3584 bytes, matching the PIO app-main stack, so the IDF build
# does not change main()/app_main() behaviour vs the reference firmware.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=3584
# FreeRTOS tick: 1000 Hz, matching the Arduino core the reference firmware ran on
# (drives vTaskDelay / motor / encoder timing granularity).
CONFIG_FREERTOS_HZ=1000

# ── Logging ──────────────────────────────────────────────────────────────────
# Default log level: INFO (3). Release builds may lower it to 0 and debug builds
# raise it to 5 via the per-app CORE_DEBUG_LEVEL (env-app-mapping.md §3 —
# several S3 envs ship at 5 for parity; do not silently lower).
CONFIG_LOG_DEFAULT_LEVEL=3

# ── Peripheral drivers (always on — no Kconfig line needed) ─────────────────
# In ESP-IDF 6.1 the TWAI, SPI, I2C, LEDC, PCNT and ADC drivers are compiled
# unconditionally: the top-level "enable" symbols (CONFIG_TWAI_ENABLE,
# CONFIG_SPI_MASTER, CONFIG_I2C_ENABLE, CONFIG_LEDC, CONFIG_PCNT, CONFIG_ADC_*)
# no longer exist, only their sub-options do. So there is nothing to set here,
# and they are simply always available to every app:
#   - TWAI (CAN) — required by canopen_node;
#   - SPI        — MCP4822 (galvo), sensors;
#   - I2C        — TCA95xx, sensors, DAC, onewire;
#   - LEDC       — the analog/PWM outputs;
#   - PCNT       — the quadrature encoders;
#   - ADC        — the analog inputs.
#
# The CAN path (CANopenModule) still uses the legacy driver/twai.h API. In
# IDF 6.1 that header emits a #warning (not a normal -W warning, so
# -Wno-deprecated-declarations cannot silence it); under strict -Werror flags
# the warning is an error. Suppress it here until the CAN path moves to
# esp_twai.h:
CONFIG_TWAI_SUPPRESS_DEPRECATE_WARN=y

# ── Bluetooth ────────────────────────────────────────────────────────────────
# NO BT symbols in the root file. The BT stack (Bluedroid classic, per D2/D3) is
# configured ONLY in the BT apps' per-app sdkconfig.defaults (Phase 3, T3.x).
# Keeping it out of the root file keeps the non-BT apps (the majority) free of
# BT's internal-RAM overhead.
#
