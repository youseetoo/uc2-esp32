# UC2 feature flags — single source of truth for all UC2_* build symbols.
# T1.4: symbol list exactly as DOCS/PORT_PLAN_STEPS/refs/env-app-mapping.md §3.
# Sourced into the build by uc2_app/Kconfig (every app REQUIRES uc2_app).
# Consumed by:
#   - uc2_app/main.cpp:  #ifdef CONFIG_UC2_<NAME> gates (T1.4)
#   - component CMakeLists: source gates (T1.6+, component-layout.md §3)
#   - component .c/.cpp:  #ifdef CONFIG_UC2_<NAME> gates
#
# Deliberately NOT here (env-app-mapping.md §4):
#   - I2C_BRIDGE_CONTROLLER  — PinConfig.h-gated (board-combo concern)
#   - ESP32S3_MODEL_XIAO     — board flag (target_compile_definitions / PinConfig)

config UC2_NODE_ROLE
    int "Node role bitmask (1=master, 2=laser, 4=dial, 8=motor, 16=scanner)"
    default 1

config UC2_CORE_DEBUG_LEVEL
    int "Core debug level (0=off, 1..5=increasingly verbose)"
    default 0
    range 0 5

config UC2_CAN_AXIS_ID
    string "CAN axis node id (empty = unused)"
    default ""

config UC2_BLUETOOTH
    bool "Bluetooth (classic + BLE)"
    default n

config UC2_BTHID
    bool "Bluetooth HID (requires UC2_BLUETOOTH)"
    default n

config UC2_PSXCONTROLLER
    bool "Classic PS3/PS4 L2CAP controller (PSController leaf)"
    default n
    depends on UC2_BLUETOOTH
    help
      Port the classic-BT PS3/PS4 L2CAP path (components/pscontroller, an Arduino-era
      C++ leaf). No current board enables it (the -DPSXCONTROLLER flag is unused in
      platformio.ini); the BLE HID path (UC2_BTHID) is the active controller route.
      Off by default so the leaf is not compiled; the feature is preserved.

