# T3.4: uc2_3 feature set (from PIO env UC2_3).
# Target: esp32 (classic). Console: UART (classic ESP32 has no USB-Serial-JTAG).
CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESP_CONSOLE_UART=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../../partitions/custom_partition.csv"

# UC2 feature flags (from platformio.ini UC2_3 build_flags; env-app-mapping.md)
CONFIG_UC2_NODE_ROLE=2
CONFIG_UC2_CORE_DEBUG_LEVEL=0
CONFIG_UC2_BLUETOOTH=y
CONFIG_UC2_BTHID=y
CONFIG_UC2_MOTOR_CONTROLLER=y
CONFIG_UC2_LASER_CONTROLLER=y
CONFIG_UC2_LED_CONTROLLER=y
CONFIG_UC2_DIGITAL_IN_CONTROLLER=y
CONFIG_UC2_USE_TCA9535=y
CONFIG_UC2_HOME_MOTOR=y
CONFIG_UC2_MESSAGE_CONTROLLER=y
CONFIG_UC2_DAC_CONTROLLER=y
CONFIG_UC2_HEAT_CONTROLLER=y
CONFIG_UC2_DS18B20_CONTROLLER=y
CONFIG_UC2_USE_FASTACCEL=y
CONFIG_UC2_STAGE_SCAN=y

# BT (Bluedroid dual-mode classic + BLE, HID host) — DOCS/bt.md fragment
CONFIG_BT_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_HID_HOST_ENABLED=y

# Strict flags (T1.1)
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_LEVEL=y
CONFIG_COMPILER_STACK_CHECK=y
